---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const target = `${base}zh-cn/real-world-development/cli/4-custom-instructions/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在重定向到自定义说明课程</title>
  </head>
  <body>
    <a href={target}>此页面已移动，请转到“使用自定义说明引导 Copilot”课程。</a>
  </body>
</html>
